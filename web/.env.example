# Optional server-side settings for Next.js and the Python drafting process.
# For local use, copy this file to web/.env.local and restart Next.js.
# The default instruction is in models.py. A blank value uses that instruction.
# Example: NORTHGATE_AGENT_PROMPT="Prioritize conflicting evidence, then missing notes."
NORTHGATE_AGENT_PROMPT=

# Only needed when selecting the Gemini API engine.
GEMINI_API_KEY=
# A blank value uses the default model in models.py.
GEMINI_MODEL=
